# 실제 Writer와 Reviser
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 로컬 Evaluator · Ollama에서 먼저 ollama pull gemma3:1b 실행
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMMA_MODEL=gemma3:1b

# 화면 폴링용 Snapshot과 Trace
REDIS_URL=redis://127.0.0.1:6379/0
RUN_TTL_SECONDS=3600

# 평가 기준, 평가 회차, 최종 실행 이력, 숙소 예약 이력
DATABASE_URL=postgresql://agent_user:agent_pwd@127.0.0.1:5433/agent_db

# Labs 09~10에서 Backend가 호출하는 날씨 조회 MCP 서버
WEATHER_MCP_URL=http://127.0.0.1:18012/mcp
WEATHER_MCP_PORT=18012

# Labs 09~10에서 Backend가 호출하는 숙소 조회 MCP 서버
HOTEL_MCP_URL=http://127.0.0.1:18011/mcp
HOTEL_MCP_PORT=18011

# Labs 09~10에서 Backend가 호출하는 숙소 예약 MCP 서버
BOOKING_MCP_URL=http://127.0.0.1:18010/mcp
BOOKING_MCP_PORT=18010

# Streamlit이 호출하는 FastAPI
API_BASE_URL=http://127.0.0.1:18000
