OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMMA_MODEL=gemma3:1b

# Worker가 PostgreSQL 데이터를 조회할 때 사용하는 MCP Server
MCP_HOST=127.0.0.1
MCP_PORT=8010
MCP_URL=http://127.0.0.1:8010/mcp

# 기존 aidevs-postgres 컨테이너의 공용 교육 DB
DATABASE_URL=postgresql://agent_user:agent_pwd@127.0.0.1:5433/agent_db

# 진행 상태(Hash)와 실행 이력(Stream)을 저장하는 aidevs-redis
REDIS_URL=redis://127.0.0.1:6379/0
RUN_TTL_SECONDS=3600

# Streamlit이 호출할 FastAPI 주소
API_BASE_URL=http://127.0.0.1:8000
