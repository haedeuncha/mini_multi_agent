# ============================================================
# 1. 기본 LLM Provider
# ============================================================

# 허용 값: openai, gemini, ollama, gemma
# - openai: OpenAI Cloud API · gpt-4.1-mini
# - gemini: Google Gemini Cloud API · gemini-3.5-flash
# - ollama: Local Ollama Server · llama3.2
# - gemma: 같은 Local Ollama Server · gemma3:4b
# ollama와 gemma는 Model 선택을 구분하는 교육용 논리 Provider 이름입니다.
# ============================================================
# 2. Cloud LLM
# ============================================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ============================================================
# 3. Local LLM · Ollama
# ============================================================

# Llama와 Gemma는 같은 Ollama Server에서 서로 다른 Model로 실행됩니다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMMA_MODEL=gemma3:4b

# ============================================================
# 4. MCP Server
# ============================================================

MCP_HOST=127.0.0.1
MCP_PORT=8010
MCP_URL=http://127.0.0.1:8010/mcp

# ============================================================
# 5. MCP Tool 데이터 소스
# ============================================================

# 날씨는 Open-Meteo 실제 API만 사용합니다. Mock fallback은 없습니다.
WEATHER_DATA_SOURCE=live

# 고객지원·여행 지식·콘텐츠·품질 기준은 PostgreSQL만 사용합니다.
SUPPORT_DATA_SOURCE=postgresql

DATABASE_URL=postgresql://agent_user:agent_pwd@127.0.0.1:5433/agent_db

# ============================================================
# 6. Frontend·Backend
# ============================================================

API_BASE_URL=http://127.0.0.1:8000
